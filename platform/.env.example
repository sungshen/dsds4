# Copy to platform/.env. Blank values do not override existing root .env settings.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=viirs-daily
# Optional Hetzner connectivity probe. Keys stay on this computer.
HETZNER_SSH_HOST=
HETZNER_SSH_USER=
HETZNER_SSH_PORT=22
HETZNER_SSH_KEY_PATH=
# Optional server SSH password. Prefer canonical names to legacy id/pw aliases.
HETZNER_SSH_PASSWORD=
HETZNER_PROJECT_PATH=
